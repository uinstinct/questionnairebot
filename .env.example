# Telegram bot credentials (https://core.telegram.org/bots/tutorial)
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_CHAT_ID=123456789

# Directory containing questionnaire subdirectories.
# When running via docker compose, leave as /app/data (matches the bind mount).
DATA_DIR=/app/data

# ---------------------------------------------------------------------------
# OpenTelemetry (OPTIONAL — telemetry is OFF unless an OTLP endpoint is set).
#
# Leave every OTEL_* var below UNSET to disable telemetry entirely: the bot then
# behaves byte-for-byte as before — no traces, metrics, logs export, or extra
# network activity. Set OTEL_EXPORTER_OTLP_ENDPOINT to opt in.
# ---------------------------------------------------------------------------
# OTLP collector endpoint. Setting this (or a signal-specific *_TRACES_ENDPOINT /
# *_METRICS_ENDPOINT / *_LOGS_ENDPOINT) ENABLES telemetry.
#OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# Wire protocol: grpc (default) or http/protobuf.
#OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# Service name reported in traces/metrics/logs (default: questionnairebot).
#OTEL_SERVICE_NAME=questionnairebot
# Extra resource attributes, comma-separated key=value pairs.
#OTEL_RESOURCE_ATTRIBUTES=deployment.environment=prod,service.version=1.0.0
